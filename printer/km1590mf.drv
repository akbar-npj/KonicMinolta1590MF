// Driver definition for Konica Minolta pagepro 1590MF / 1580MF / bizhub 15 / bizhub 16
// Open Source CUPS Driver (Native 64-bit & ARM compatible)

#include <font.defs>
#include <media.defs>

Font *

Manufacturer "KONICA MINOLTA"
Version "1.0.0"

// Filter definition: CUPS raster input to rastertokm1590mf
Filter application/vnd.cups-raster 33 rastertokm1590mf

// Supported resolutions
Resolution k 1 0 0 0 "300dpi/300 DPI"
*Resolution k 1 0 0 0 "600dpi/600 DPI"
Resolution k 1 0 0 0 "1200dpi/1200HQ (2400x600 dpi)"

// Supported paper sizes and margins
HWMargins 12 12 12 12
*MediaSize A4
MediaSize A5
MediaSize A6
MediaSize B5
MediaSize B6
MediaSize Executive
MediaSize Legal
MediaSize Letter
MediaSize EnvC5
MediaSize EnvDL
MediaSize EnvMonarch
MediaSize Env10

// Paper Input Trays
*InputSlot 0 "Auto/Auto-Select"
InputSlot 1 "Tray1/Tray 1 (Cassette)"
InputSlot 4 "MPTray/Manual Feed Slot"

// Media Types
*MediaType 0 "PLAIN/Plain Paper"
MediaType 1 "THIN/Thin Paper"
MediaType 2 "THICK/Thick Paper"
MediaType 3 "THICKER/Thicker Paper"
MediaType 4 "BOND/Bond Paper"
MediaType 6 "ENV/Envelopes"
MediaType 7 "ENV-THICK/Thick Envelopes"
MediaType 8 "ENV-THIN/Thin Envelopes"

// Toner Save Option
Option "brlaserEconomode/Toner Save Mode" Boolean AnySetup 10
  *Choice False/Off "<</cupsInteger10 0>>setpagedevice"
  Choice True/On "<</cupsInteger10 1>>setpagedevice"

{
  ModelName "pagepro 1590MF"
  Attribute "NickName" "" "KONICA MINOLTA pagepro 1590MF Open Source Driver"
  Attribute "1284DeviceID" "" "MFG:KONICA MINOLTA;MDL:pagepro 1590MF;CMD:PJL,HBP;CLS:PRINTER;CID:Brother Laser Type1;"
  Duplex rotated
  PCFileName "km-pagepro1590mf.ppd"
}

{
  ModelName "pagepro 1580MF"
  Attribute "NickName" "" "KONICA MINOLTA pagepro 1580MF Open Source Driver"
  Attribute "1284DeviceID" "" "MFG:KONICA MINOLTA;MDL:pagepro 1580MF;CMD:PJL,HBP;CLS:PRINTER;CID:Brother Laser Type1;"
  PCFileName "km-pagepro1580mf.ppd"
}

{
  ModelName "bizhub 16"
  Attribute "NickName" "" "KONICA MINOLTA bizhub 16 Open Source Driver"
  Attribute "1284DeviceID" "" "MFG:KONICA MINOLTA;MDL:bizhub 16;CMD:PJL,HBP;CLS:PRINTER;CID:Brother Laser Type1;"
  Duplex rotated
  PCFileName "km-bizhub16.ppd"
}

{
  ModelName "bizhub 15"
  Attribute "NickName" "" "KONICA MINOLTA bizhub 15 Open Source Driver"
  Attribute "1284DeviceID" "" "MFG:KONICA MINOLTA;MDL:bizhub 15;CMD:PJL,HBP;CLS:PRINTER;CID:Brother Laser Type1;"
  PCFileName "km-bizhub15.ppd"
}
